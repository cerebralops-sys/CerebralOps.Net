<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cerebral Ops</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Cerebral Ops — strategy, technology, marketing and operations.")" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <style>
        .navbar-logo-link { display: flex !important; align-items: center; text-decoration: none; }
        .navbar-logo { height: 62px !important; width: auto !important; margin-right: .75rem !important; opacity: 1 !important; display: block !important; }
        .navbar.scrolled .navbar-logo { height: 62px !important; margin-right: .75rem !important; opacity: 1 !important; display: block !important; }
        .navbar-brand { display: none !important; }
        .navbar.scrolled .navbar-brand { display: none !important; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-logo-link" href="/">
                <img src="/images/CerebralOpsLogoDark294x118.png" class="navbar-logo" alt="Cerebral Ops" />
            </a>
            <a class="navbar-brand" href="/"><span class="brand-cerebral">Cerebral</span> <span class="brand-ops">Ops</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav"><ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="/about">About</a></li>
                <li class="nav-item"><a class="nav-link" href="/services">Services</a></li>
                <li class="nav-item"><a class="nav-link" href="/case-studies">Case Studies</a></li>
                <li class="nav-item"><a class="nav-link" href="/who-we-serve">Who We Serve</a></li>
                <li class="nav-item"><a class="nav-link" href="/why-cerebral-ops">Why Cerebral Ops</a></li>
                <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
            </ul></div>
        </div>
    </nav>
</header>
<main>@RenderBody()</main>
<footer class="footer"><div class="container text-center"><p>&copy; @DateTime.UtcNow.Year Cerebral Ops. All rights reserved.</p><p class="mt-2"><a href="/privacy-policy">Privacy Policy</a> &nbsp; | &nbsp; <a href="/terms-and-conditions">Terms</a> &nbsp; | &nbsp; <a href="mailto:hello@cerebralops.in">hello@cerebralops.in</a></p></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
