@page "/assessments/assessment"
@{ ViewData["Title"]="Business Assessment"; ViewData["Description"]="A short browser-based business systems assessment."; }
<section class="page-section"><div class="container"><div class="col-lg-8 mx-auto"><h1 class="section-title">Business Systems Assessment</h1><p class="lead">This assessment runs entirely in your browser. No answers are submitted or emailed.</p><form id="assessmentForm"><div class="mb-4"><label class="form-label" for="revops">Revenue operations</label><select class="form-select" id="revops" required><option value="">Choose one</option><option>Needs improvement</option><option>Developing</option><option>Consistent</option><option>Optimized</option></select></div><div class="mb-4"><label class="form-label" for="process">Processes and ownership</label><select class="form-select" id="process" required><option value="">Choose one</option><option>Needs improvement</option><option>Developing</option><option>Consistent</option><option>Optimized</option></select></div><div class="mb-4"><label class="form-label" for="data">Performance data and KPIs</label><select class="form-select" id="data" required><option value="">Choose one</option><option>Needs improvement</option><option>Developing</option><option>Consistent</option><option>Optimized</option></select></div><div class="mb-4"><label class="form-label" for="systems">Technology and automation</label><select class="form-select" id="systems" required><option value="">Choose one</option><option>Needs improvement</option><option>Developing</option><option>Consistent</option><option>Optimized</option></select></div><button class="btn btn-primary" type="submit">View assessment summary</button></form><div id="assessmentResult" class="value-card mt-4" hidden></div></div></div></section>
@section Scripts { <script>document.getElementById('assessmentForm').addEventListener('submit',function(e){e.preventDefault();const ids=['revops','process','data','systems'];const map={'Needs improvement':1,'Developing':2,'Consistent':3,'Optimized':4};const vals=ids.map(id=>document.getElementById(id).value);if(vals.some(v=>!v))return;const avg=vals.map(v=>map[v]).reduce((a,b)=>a+b,0)/4;const r=document.getElementById('assessmentResult');r.innerHTML='<h2>'+ (avg<2?'Focus on foundational improvements':avg<3?'Build consistency next':avg<3.75?'Improve integration and measurement':'Sustain and optimize') +'</h2><p>Your average maturity rating is '+avg.toFixed(1)+' out of 4.</p>';r.hidden=false;});</script> }
